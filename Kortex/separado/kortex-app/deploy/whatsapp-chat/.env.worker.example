# Copy to a gitignored .env.whatsapp-worker.staging.local or production.local.
# Use the corresponding Supabase project; never point a staging worker at production.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
# Preserve the origin already accepted by the existing Evolution server.
EVOLUTION_REQUEST_ORIGIN=
WHATSAPP_WORKER_ID=evolution-local
WHATSAPP_ENABLE_GROUPS=false
