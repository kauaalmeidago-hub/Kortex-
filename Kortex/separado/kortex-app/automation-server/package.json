{
  "name": "@kortex/automation-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:card-preview": "npm run build && node scripts/check-card-preview.mjs",
    "test:card-portals": "npm run build && node scripts/check-card-portals.mjs",
    "test:card-selection": "npm run build && node scripts/check-card-selection.mjs",
    "test:card-batch": "npm run build && node scripts/check-card-batch.mjs",
    "test:portal-sessions": "npm run build && node scripts/check-portal-sessions.mjs",
    "browser:onboard": "tsx src/scripts/koa-browser-onboard.ts",
    "browser:check": "tsx src/scripts/koa-browser-check.ts",
    "credential:register": "tsx src/scripts/register-portal-credential.ts",
    "session:bootstrap": "tsx src/scripts/session-bootstrap.ts",
    "check": "npm run typecheck && npm test",
    "permanent:install": "node scripts/install-permanent.mjs install",
    "permanent:status": "node scripts/install-permanent.mjs status",
    "permanent:stop": "node scripts/install-permanent.mjs stop",
    "permanent:remove": "node scripts/install-permanent.mjs remove",
    "permanent:check": "npm run build && node scripts/check-permanent-runtime.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.2.0",
    "pg": "^8.23.1",
    "playwright": "^1.49.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  }
}
